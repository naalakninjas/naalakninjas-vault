# Supabase configuration.
# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API). Do not commit .env.
#
# VITE_SUPABASE_URL must be the project base URL with no path suffix —
# supabase-js appends /rest/v1 itself.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Shared secret for the daily Supabase keep-alive cron (api/keep-alive.js).
# Set this in the Vercel project settings, not here: Vercel sends it as a
# bearer token on cron invocations, and the endpoint refuses to run without it.
# Any long random string works, e.g. `openssl rand -hex 32`.
CRON_SECRET=
